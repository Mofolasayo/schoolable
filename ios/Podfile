# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Pin Firebase iOS SDK to a pre-Swift-6 release that also stays compatible with ML Kit (<8.x GoogleUtilities).
$FirebaseSDKVersion = '10.16.0'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Patch FirebaseCoreInternal to avoid Swift 6-only syntax when building with Xcode 15.x.
  firebase_internal_root = 'Pods/FirebaseCoreInternal/FirebaseCore/Internal/Sources'

  unfair_lock = File.join(firebase_internal_root, 'Utilities/FIRAllocatedUnfairLock.swift')
  if File.exist?(unfair_lock)
    begin
      File.chmod(0644, unfair_lock)
    rescue Errno::EPERM
      # If permissions are locked down, continue and attempt to write anyway.
    end
    contents = File.read(unfair_lock)
    patched = contents.gsub('initialState: sending State', 'initialState: State')
    File.write(unfair_lock, patched) if patched != contents
  end

  heartbeats_payload = File.join(firebase_internal_root, 'HeartbeatLogging/HeartbeatsPayload.swift')
  if File.exist?(heartbeats_payload)
    begin
      File.chmod(0644, heartbeats_payload)
    rescue Errno::EPERM
      # If permissions are locked down, continue and attempt to write anyway.
    end
    contents = File.read(heartbeats_payload)
    patched = contents
      .gsub('internal import GoogleUtilities_NSData', 'import GoogleUtilities_NSData')
      .gsub('internal import GoogleUtilities', 'import GoogleUtilities')
    File.write(heartbeats_payload, patched) if patched != contents
  end
end
